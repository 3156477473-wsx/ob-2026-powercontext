# 环境变量示例
# 复制为 .env 后按实际情况修改。不要提交真实密钥。

# ---------- seekdb ----------
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=test

# ---------- PowerContext ----------
POWERCONTEXT_URL=http://127.0.0.1:8100
# 留空则自动创建/查找名为「MiniMax SDD 任务上下文」的 Scope
POWERCONTEXT_SCOPE=

# ---------- MiniMax ----------
# 在 https://platform.minimaxi.com 获取；不要提交到仓库
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M1
MINIMAX_API_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2